            {
                "box": {
                    "code": "Buffer loopbuf;\nParam speed(1);\nParam loop(1);\nParam play(1);\nParam chance(0.5);\nParam fade_samps(220);    // crossfade length in SAMPLES (220 @ 44.1k ≈ 5ms)\nParam octave_mode(1);     // 1 = random octave up/down enabled, 0 = off (plain speed)\n\nHistory phase(0);\nHistory current_speed(1);\nHistory next_trigger(0);\nHistory local_playing(1);\n\nHistory tail_phase(0);\nHistory tail_speed(1);\nHistory fade_count(0);\n\nchans = channels(loopbuf);\ncurrent_buf_len = dim(loopbuf);\n\nif (play <= 0) {\n    local_playing = 0;\n} else if (play > 0 && local_playing == 0 && phase == 0) {\n    local_playing = 1;\n}\n\ntriggered = 0;\n\nif (play > 0 && local_playing > 0) {\n    next_trigger = next_trigger - 1;\n\n    if (next_trigger <= 0) {\n        uni_noise1 = (noise() * 0.5) + 0.5;\n        uni_noise2 = (noise() * 0.5) + 0.5;\n\n        next_trigger = 4000 + (uni_noise1 * 20000);\n\n        if (uni_noise2 < chance && current_buf_len > 1) {\n            triggered = 1;\n        }\n    }\n\n    if (triggered == 1) {\n        tail_phase = phase;\n        tail_speed = current_speed;\n        fade_count = fade_samps;\n\n        local_noise1 = (noise() * 0.5) + 0.5;\n        new_phase = local_noise1 * current_buf_len;\n\n        // pick octave up (x2) or octave down (x0.5), 50/50 -- only if octave_mode is on\n        pitch_mod = 1;\n        if (octave_mode > 0) {\n            pitch_mod = 0.5;\n            if (noise() > 0) {\n                pitch_mod = 2;\n            }\n        }\n\n        phase = new_phase;\n        current_speed = speed * pitch_mod;\n    }\n\n    phase = phase + current_speed;\n\n    if (phase >= current_buf_len || phase < 0) {\n        if (loop > 0) {\n            phase = wrap(phase, 0, current_buf_len);\n        } else {\n            phase = 0;\n            current_speed = 0;\n            local_playing = 0;\n        }\n    }\n\n    if (fade_count > 0) {\n        tail_phase = tail_phase + tail_speed;\n        if (tail_phase >= current_buf_len || tail_phase < 0) {\n            tail_phase = wrap(tail_phase, 0, current_buf_len);\n        }\n        fade_count = fade_count - 1;\n    }\n} else {\n    phase = 0;\n    current_speed = speed;\n    fade_count = 0;\n}\n\nphase = fixnan(phase);\ntail_phase = fixnan(tail_phase);\n\nmain_left = peek(loopbuf, phase, 0, boundmode=\"wrap\", interp=\"linear\");\nmain_right = main_left;\nif (chans > 1) {\n    main_right = peek(loopbuf, phase, 1, boundmode=\"wrap\", interp=\"linear\");\n}\n\nleft_sig = main_left;\nright_sig = main_right;\n\nif (fade_count > 0) {\n    tail_left = peek(loopbuf, tail_phase, 0, boundmode=\"wrap\", interp=\"linear\");\n    tail_right = tail_left;\n    if (chans > 1) {\n        tail_right = peek(loopbuf, tail_phase, 1, boundmode=\"wrap\", interp=\"linear\");\n    }\n\n    fade_pos = fade_count / fade_samps;\n    fade_in = cos(fade_pos * 1.5707963);\n    fade_out = sin(fade_pos * 1.5707963);\n\n    left_sig = (main_left * fade_in) + (tail_left * fade_out);\n    right_sig = (main_right * fade_in) + (tail_right * fade_out);\n}\n\nout1 = left_sig;\nout2 = right_sig;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
